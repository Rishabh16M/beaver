# =========================================================================
# Beaver Platform General Environment Configurations Reference
# =========================================================================

# --- Security ---
JWT_SECRET=beaver_jwt_secret_key_99

# --- MongoDB Atlas Connections (Auth, Chat, Workspace services) ---
# Paste your MongoDB Atlas Connection URI here:
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/beaver?retryWrites=true&w=majority

# --- MySQL Connection Credentials (Audit service) ---
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASS=your_mysql_password
MYSQL_DB=beaver_audits

# --- Optional AI Service Key ---
GEMINI_API_KEY=your_gemini_api_key_here
