VITE_WORKSPACE_URL=http://localhost:5002/api/workspaces
VITE_CHAT_URL=http://localhost:5003
VITE_AUDIT_URL=http://localhost:5004/api/audits
VITE_NOTIFICATION_URL=http://localhost:5006
VITE_AI_URL=http://localhost:5005/api/ai
