# =========================================================================
# Audit Service — Environment Variables
# Copy this file to .env and fill in your values
# =========================================================================

PORT=5004

# JWT secret — must match auth-service JWT_SECRET
JWT_SECRET=your_jwt_secret_here

# Database Configuration (MySQL / SQLite Fallback)
# Set MYSQL_HOST=sqlite to force local SQLite usage.
# If MYSQL_HOST is empty or connection fails locally, the service falls back to SQLite.
MYSQL_HOST=your_mysql_host
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASS=your_mysql_password
MYSQL_DB=railway

# Note: The service natively supports default Railway MySQL environment variable names
# (e.g. MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE) out of the box.
