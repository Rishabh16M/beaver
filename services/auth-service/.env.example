# =========================================================================
# Authentication Service — Environment Variables
# Copy this file to .env and fill in your values
# =========================================================================

PORT=5001

# JWT secret — use a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/beaver_auth?retryWrites=true&w=majority
