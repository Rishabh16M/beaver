# =========================================================================
# Chat Service — Environment Variables
# Copy this file to .env and fill in your values
# =========================================================================

PORT=5003

# JWT secret — must match auth-service JWT_SECRET
JWT_SECRET=your_jwt_secret_here

# URL of the AI service (update to deployed URL in production)
AI_SERVICE_URL=http://localhost:5005/api/ai/chat

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/beaver_chat?retryWrites=true&w=majority
