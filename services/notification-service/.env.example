# =========================================================================
# Notification Service — Environment Variables
# Copy this file to .env and fill in your values
# =========================================================================

PORT=5006

# URLs of upstream services (update to deployed URLs in production)
AUTH_SERVICE_URL=http://localhost:5001/api/auth
WORKSPACE_SERVICE_URL=http://localhost:5002/api

# SMTP credentials for sending real emails
# If left blank, an Ethereal test account is used (check console for preview URL)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM="Beaver Notifications" <your_email@gmail.com>
